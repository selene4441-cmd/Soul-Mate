# 后端地址（Next.js 同源代理的目标）
# 默认 8010：8000 常被其他服务占用（例如别的 demo 后端），start.ps1 会自动挑一个空闲端口并改写本文件
API_BASE_URL=http://127.0.0.1:8010

# 前端请求前缀；默认走同源代理，一般不用改
NEXT_PUBLIC_API_BASE=/api/proxy/v1

# WebSocket 直连地址（必须和上面 API_BASE_URL 的 host:port 一致，否则 cookie 带不过去）
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8010
